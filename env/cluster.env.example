# oc-cluster topology and tunables.
# Copy to env/cluster.env (gitignored) and edit for your site.
# bash syntax: this file is sourced by scripts/lib.sh.

# --- global ---
export OC_PORT=4096                # opencode serve port on every worker
# Model: "zai/glm-4.5-air" = standard z.ai API-key billing (needs zai key, see
# scripts/auth_provider_key.sh); "zai-coding-plan/glm-5.3" = coding-plan subscription.
export OC_MODEL="zai/glm-4.5-air"
export OC_SMALL_MODEL="zai/glm-4.5-air"
export OC_LLM_HOST="api.z.ai"      # LLM API host; pinned to 127.0.0.1 on workers, reached via ssh -R tunnel
export OC_TARBALL="$HOME/opencode-linux-x64.tar.gz"  # offline install tarball (linux x64)
export OC_VERSION="1.18.24"        # stamped into worker AGENTS.md for reference
export OC_SERVE_USER="opencode"    # HTTP Basic username for the serve API
export OC_FWD_BASE=14096           # WSL localhost forward ports: worker i gets base+index
export OC_ATTACH_BIN="$HOME/.opencode/bin/opencode"  # attach client binary in orchestrator WSL (Hub-0)

# --- workers ---
# Space-separated keys. To add a worker: append a key and add its per-key block.
export WORKERS="W1 W2"

export W1_NAME="wk-1"
export W1_IP="10.0.0.11"
export W1_USER="root"

export W2_NAME="wk-2"
export W2_IP="10.0.0.12"
export W2_USER="root"

# Optional per-worker machine facts injected into the worker AGENTS.md:
#   worker/notes.d/<NAME>.md  (gitignored; markdown bullet lines, e.g. DUT history,
#   hardware notes, protected services). Missing file = empty notes section.
